# Backend settings. The backend dev script reads this file as ../.env.

# Vertex AI API key (express mode). With a key, the provider calls the global
# Vertex AI endpoint, so a project id or a region would have no effect.
GOOGLE_VERTEX_API_KEY=your-api-key

# Browser origins allowed to call the backend, comma-separated.
# Default: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend port. Default: 3001
# PORT=3001
